# DesOS branding for Calamares 3.3.14 (Ubuntu 26.04 package, Qt 6).
# Design and the confirmed upstream contracts: installer/DESIGN.md.
---
componentName: desos
welcomeStyleCalamares: false
# The welcome picture is a 2x PNG; let Calamares fit it to the page instead of
# showing it at its natural 1440 pixels.
welcomeExpandingLogo: true
# The partitions and summary pages are wider and taller than the DEs-UI
# workspace at 1280x800 (v4 image). "fullscreen" was tried and is ignored by
# des-comp 0.1.1; the fix belongs in the compositor.
windowExpanding: normal
windowSize: 960px,640px
windowPlacement: center
# The step rail is calamares-sidebar.qml. If it fails to load the rail is
# empty and every page and button still works. Set this to "widget" to get
# Calamares's own list back; the style colours below are chosen for it too.
sidebar: qml
# Back, Next and Cancel stay native widgets: nobody should be unable to
# install because a QML file did not load.
navigation: widget
strings:
  productName: DesOS
  shortProductName: DesOS
  version: 0.1.0 Preview 1
  shortVersion: 0.1
  versionedName: DesOS 0.1 Preview
  shortVersionedName: DesOS 0.1
  bootloaderEntryName: DesOS
images:
  # PNG, because the window icon and the welcome picture are decoded by
  # QPixmap and the live image carries no Qt SVG image-format plugin.
  productIcon: icon.png
  # Read by Calamares's own SVG renderer; used by the widget rail only.
  productLogo: icon.svg
  productWelcome: welcome.png
style:
  SidebarBackground: "#0a0e12"
  SidebarText: "#8fa3b0"
  SidebarTextCurrent: "#dce7ec"
  SidebarBackgroundCurrent: "#0f2a29"
slideshow: show.qml
slideshowAPI: 2
uploadServer:
  type: none
