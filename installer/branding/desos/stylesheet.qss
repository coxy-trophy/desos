/* DesOS installer: DEs-UI's matte instrument surfaces on Calamares 3.3.14.
 *
 * Calamares owns every widget's behaviour; this file only paints them.
 * tests/test_installer_branding.py parses it and checks every text, focus and
 * control-edge colour pair against WCAG AA. Change a colour, run the test.
 *
 * Tokens (the first nine are DEs-UI's own, from des-ui/shell/src/ui.rs):
 *   ground  #06080b   page                 text       #dce7ec
 *   panel   #0a0e12   inset fields, rail   secondary  #8fa3b0
 *   track   #141b22   resting controls     accent     #4fd8ce
 *   line    #1a232b   quiet separators     caution    #f5b85a
 *   strong  #2a3742   frames, grid lines
 *   edge    #5b7385   control outlines: 3:1 on ground, panel and track
 *   hover   #1b252e   tint  #0f2a29 (selected)   pressed #254c4d
 *   quiet   #7d909c   disabled text, still 4.5:1 on ground, panel and track
 *   chunk   #29706b   progress fill and resting primary button, 4.5:1 under text
 *
 * Images are PNG with absolute paths: the style sheet is applied as a string,
 * so relative paths would resolve against Calamares's working directory, and
 * the live image has no Qt SVG image-format plugin.
 */

/* ---- Foundation ------------------------------------------------------- */

QWidget {
    background-color: #06080b;
    color: #dce7ec;
    font-family: "Chakra Petch", "Noto Sans", sans-serif;
    font-size: 14px;
    selection-background-color: #4fd8ce;
    selection-color: #06080b;
}
QWidget:disabled { color: #7d909c; }
QLabel { background-color: transparent; }

#mainApp { background-color: #06080b; }
/* Widget rail, used only when branding.desc says "sidebar: widget". */
#sidebarApp { background-color: #0a0e12; }
#logoApp { background-color: #0a0e12; }

QToolTip {
    color: #dce7ec;
    background-color: #141b22;
    border: 1px solid #5b7385;
    border-radius: 4px;
    padding: 6px 8px;
}

/* ---- Buttons ---------------------------------------------------------- */

QPushButton {
    background-color: #141b22;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 22px;
    min-width: 56px;
}
QPushButton:hover { background-color: #1b252e; border-color: #8fa3b0; }
QPushButton:focus { border: 2px solid #4fd8ce; padding: 5px 15px; }
QPushButton:pressed { background-color: #254c4d; color: #dce7ec; }
QPushButton:disabled { background-color: #0a0e12; color: #7d909c; border-color: #2a3742; }

/* The one forward action on each page, and the default button of a dialog.
   It rests on a quiet teal and lights up to full accent under the pointer
   or the keyboard, so focus is a 3:1 change in the fill, not only a ring. */
QPushButton#view-button-next, QPushButton:default {
    background-color: #29706b;
    color: #dce7ec;
    border: 1px solid #4fd8ce;
    font-weight: 600;
}
QPushButton#view-button-next:hover, QPushButton:default:hover {
    background-color: #4fd8ce;
    color: #06080b;
    border-color: #4fd8ce;
}
QPushButton#view-button-next:focus, QPushButton:default:focus {
    background-color: #4fd8ce;
    color: #06080b;
    border: 2px solid #ffffff;
}
QPushButton#view-button-next:pressed, QPushButton:default:pressed {
    background-color: #254c4d;
    color: #dce7ec;
    border-color: #4fd8ce;
}
QPushButton#view-button-next:disabled, QPushButton:default:disabled {
    background-color: #0a0e12;
    color: #7d909c;
    border: 1px solid #2a3742;
    font-weight: 500;
}

QPushButton#aboutButton, QPushButton#debugButton {
    background-color: #0a0e12;
    color: #8fa3b0;
    border: 1px solid #5b7385;
}
QPushButton#aboutButton:hover, QPushButton#debugButton:hover { background-color: #141b22; color: #dce7ec; }
QPushButton#aboutButton:focus, QPushButton#debugButton:focus { border: 2px solid #4fd8ce; }

QToolButton {
    background-color: #141b22;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    padding: 5px 8px;
}
QToolButton:hover { background-color: #1b252e; border-color: #8fa3b0; }
QToolButton:focus { border: 2px solid #4fd8ce; padding: 4px 7px; }
QToolButton:pressed, QToolButton:checked { background-color: #254c4d; color: #dce7ec; }
QToolButton:disabled { background-color: #0a0e12; color: #7d909c; border-color: #2a3742; }
QToolBar { background-color: #06080b; border: none; spacing: 6px; }

/* ---- Text entry ------------------------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox {
    background-color: #0a0e12;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 22px;
    selection-background-color: #4fd8ce;
    selection-color: #06080b;
}
QLineEdit { placeholder-text-color: #8fa3b0; }
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QAbstractSpinBox:hover { border-color: #8fa3b0; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus {
    border: 2px solid #4fd8ce;
    padding: 4px 7px;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled {
    background-color: #06080b;
    color: #7d909c;
    border-color: #2a3742;
}
QLineEdit:read-only { background-color: #06080b; color: #8fa3b0; }
/* The installation log. */
QPlainTextEdit { font-family: "JetBrains Mono", "Noto Sans Mono", monospace; font-size: 12px; }

QAbstractSpinBox { padding-right: 28px; }
QAbstractSpinBox:focus { border: 2px solid #4fd8ce; padding: 4px 27px 4px 7px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 22px;
    background-color: #141b22;
    border-left: 1px solid #5b7385;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 5px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 5px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #1b252e; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #254c4d; }
QAbstractSpinBox::up-arrow {
    image: url(/usr/share/calamares/branding/desos/img/arrow-up.png);
    width: 12px;
    height: 12px;
}
QAbstractSpinBox::down-arrow {
    image: url(/usr/share/calamares/branding/desos/img/arrow-down.png);
    width: 12px;
    height: 12px;
}
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off {
    image: url(/usr/share/calamares/branding/desos/img/arrow-up-disabled.png);
}
QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off {
    image: url(/usr/share/calamares/branding/desos/img/arrow-down-disabled.png);
}

/* ---- Choosers --------------------------------------------------------- */

QComboBox {
    background-color: #141b22;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    padding: 5px 34px 5px 10px;
    min-height: 22px;
}
QComboBox:hover { background-color: #1b252e; border-color: #8fa3b0; }
QComboBox:focus, QComboBox:on { border: 2px solid #4fd8ce; padding: 4px 33px 4px 9px; }
QComboBox:disabled { background-color: #0a0e12; color: #7d909c; border-color: #2a3742; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background-color: transparent;
}
QComboBox::down-arrow {
    image: url(/usr/share/calamares/branding/desos/img/arrow-down.png);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(/usr/share/calamares/branding/desos/img/arrow-down-disabled.png);
}
QComboBox QAbstractItemView {
    background-color: #0a0e12;
    color: #dce7ec;
    border: 1px solid #5b7385;
    padding: 4px;
    selection-background-color: #0f2a29;
    selection-color: #dce7ec;
    outline: 0;
}

QCheckBox, QRadioButton {
    background-color: transparent;
    color: #dce7ec;
    spacing: 10px;
    padding: 4px 6px;
    border: 2px solid transparent;
    border-radius: 6px;
    min-height: 20px;
}
QCheckBox:focus, QRadioButton:focus { border: 2px solid #4fd8ce; }
QCheckBox:disabled, QRadioButton:disabled { color: #7d909c; }

QCheckBox::indicator, QAbstractItemView::indicator, QGroupBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #0a0e12;
    border: 1px solid #8fa3b0;
    border-radius: 3px;
}
QCheckBox::indicator:hover, QAbstractItemView::indicator:hover, QGroupBox::indicator:hover { border-color: #dce7ec; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked, QGroupBox::indicator:checked {
    background-color: #4fd8ce;
    border: 1px solid #4fd8ce;
    image: url(/usr/share/calamares/branding/desos/img/check.png);
}
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate {
    background-color: #4fd8ce;
    border: 1px solid #4fd8ce;
    image: url(/usr/share/calamares/branding/desos/img/dash.png);
}
QCheckBox::indicator:disabled, QAbstractItemView::indicator:disabled, QGroupBox::indicator:disabled {
    background-color: #06080b;
    border: 1px solid #5b7385;
}
QCheckBox::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled {
    background-color: #141b22;
    border: 1px solid #5b7385;
    image: url(/usr/share/calamares/branding/desos/img/check-disabled.png);
}

/* Off is a thin ring, on is a thick accent ring: a shape change, no image. */
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #0a0e12;
    border: 1px solid #8fa3b0;
    border-radius: 8px;
}
QRadioButton::indicator:hover { border-color: #dce7ec; }
QRadioButton::indicator:checked {
    width: 6px;
    height: 6px;
    background-color: #06080b;
    border: 5px solid #4fd8ce;
    border-radius: 8px;
}
QRadioButton::indicator:disabled { background-color: #06080b; border: 1px solid #5b7385; }
QRadioButton::indicator:checked:disabled { border: 5px solid #5b7385; }

/* greetd authentication is required in this preview. Keep the unavailable
   upstream option visible and accessible, with an explicit explanation. */
QCheckBox#checkBoxDoAutoLogin {
    qproperty-enabled: false;
    qproperty-text: "Automatic login (unavailable in this preview)";
    qproperty-toolTip: "Sign in with your chosen password after installation.";
}

/* ---- Lists, tables, trees --------------------------------------------- */

QAbstractItemView {
    background-color: #0a0e12;
    alternate-background-color: #141b22;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    selection-background-color: #0f2a29;
    selection-color: #dce7ec;
    gridline-color: #2a3742;
    padding: 1px;
    outline: 0;
}
QAbstractItemView:focus { border: 2px solid #4fd8ce; padding: 0; }
QAbstractItemView:disabled { background-color: #06080b; color: #7d909c; border-color: #2a3742; }
QAbstractItemView::item { padding: 4px 6px; }
QAbstractItemView::item:hover { background-color: #1b252e; color: #dce7ec; }
QAbstractItemView::item:selected { background-color: #0f2a29; color: #dce7ec; }
QAbstractItemView::item:selected:hover { background-color: #254c4d; color: #dce7ec; }
QAbstractItemView::item:disabled { color: #7d909c; }
/* QTreeView::branch is left alone on purpose: styling it without supplying
   images removes the expand arrows. */

QHeaderView { background-color: #141b22; border: none; }
QHeaderView::section {
    background-color: #141b22;
    color: #8fa3b0;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #2a3742;
    border-bottom: 1px solid #2a3742;
    font-weight: 600;
}
QTableCornerButton::section { background-color: #141b22; border: none; }

/* ---- Containers ------------------------------------------------------- */

QGroupBox {
    background-color: transparent;
    border: 1px solid #2a3742;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #8fa3b0;
    background-color: #06080b;
}
QGroupBox:focus { border: 2px solid #4fd8ce; }

QScrollArea { background-color: transparent; border: none; }
QScrollArea > QWidget > QWidget { background-color: transparent; }
#scrollAreaWidgetContents { background-color: transparent; }
QAbstractScrollArea::corner { background-color: #0a0e12; border: none; }

QScrollBar:vertical { background-color: #0a0e12; width: 14px; margin: 0; border: none; }
QScrollBar:horizontal { background-color: #0a0e12; height: 14px; margin: 0; border: none; }
QScrollBar::handle:vertical { background-color: #5b7385; border-radius: 4px; min-height: 32px; margin: 3px; }
QScrollBar::handle:horizontal { background-color: #5b7385; border-radius: 4px; min-width: 32px; margin: 3px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background-color: #8fa3b0; }
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed { background-color: #4fd8ce; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QMenu {
    background-color: #0a0e12;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { background-color: transparent; padding: 6px 22px 6px 12px; border-radius: 4px; }
QMenu::item:selected { background-color: #0f2a29; color: #dce7ec; }
QMenu::item:disabled { color: #7d909c; }
QMenu::separator { height: 1px; background-color: #2a3742; margin: 4px 6px; }

/* Dialogs stay on the page colour: their plain container widgets paint the
   foundation background, so a second dialog colour would come out patchy. */
QSplitter::handle { background-color: #2a3742; }

/* ---- Installing ------------------------------------------------------- */

QProgressBar {
    background-color: #06080b;
    color: #dce7ec;
    border: 1px solid #5b7385;
    border-radius: 4px;
    text-align: center;
    min-height: 20px;
    font-family: "JetBrains Mono", "Noto Sans Mono", monospace;
    font-size: 12px;
}
QProgressBar::chunk { background-color: #29706b; border-radius: 3px; }

/* ---- Welcome ---------------------------------------------------------- */

#languageWidget { min-width: 240px; }

/* ---- Partitions ------------------------------------------------------- */

#bootInfoLabel, #deviceInfoLabel { color: #8fa3b0; }
/* The disk bars paint themselves; keep the generic list frame off them. */
PartitionBarsView {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    padding: 0;
}
PartitionBarsView:focus { border: 2px solid #4fd8ce; }
/* Calamares paints partition names in fixed black, and sizes in fixed grey,
   whatever the palette says. Only a light plate keeps the names legible;
   see "What the style sheet cannot reach" in installer/DESIGN.md. */
PartitionLabelsView {
    background-color: #eef3f6;
    color: #000000;
    border: 1px solid #5b7385;
    border-radius: 0;
    padding: 1px;
    /* The chosen partition's name is black too, so its highlight stays light. */
    selection-background-color: #4fd8ce;
    selection-color: #000000;
}
PartitionLabelsView:focus { border: 2px solid #4fd8ce; padding: 0; }

/* ---- Users ------------------------------------------------------------ */

#labelFullNameError, #labelUsernameError, #labelHostnameError,
#labelUserPasswordError, #labelRootPasswordError {
    color: #f5b85a;
}

/* ---- Summary ---------------------------------------------------------- */

#summaryItemTitle {
    color: #8fa3b0;
    font-weight: 600;
    padding: 6px 0 2px 0;
}
#summaryItemBody {
    background-color: #0a0e12;
    color: #dce7ec;
    border-left: 2px solid #2a3742;
    padding: 6px 12px;
}
