<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DesOS</vendor>
  <action id="org.desos.installer.launch">
    <description>Install DesOS</description>
    <message>Start the DesOS installer from this live session</message>
    <icon_name>desos-installer</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/desos-installer-helper</annotate>
  </action>
</policyconfig>
