#!/usr/bin/python3 -I
"""Work on DEs-UI from DesOS itself: build it here and update to it with apt.

    desos-dev setup [--source DIR]        once: get DEs-UI's source and make the local channel
    desos-dev update [--source DIR] [--no-pull]
                                          pull, build, sign into the channel, upgrade
    desos-dev status                      what is installed and what the channel holds
    desos-dev publish [--repo OWNER/NAME] [--tag updates]
                                          upload the channel as the files of a GitHub release
    desos-dev follow [URL]                on another machine: take updates from a published channel

Updates go through apt, so desos-undo takes its snapshot first and
`sudo desos-undo rollback` brings back the desktop as it was.
"""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import urllib.request

REPOSITORY = 'https://github.com/coxy-trophy/des-ui.git'
# Where `publish` uploads and `follow` reads by default: a release of the DesOS repository.
RELEASES = 'coxy-trophy/desos'
TAG = 'updates'
SOURCE = Path.home() / 'des-ui'
PACKAGES = ('des-ui', 'des-ui-music', 'des-ui-greeter', 'des-ui-plymouth')
CHANNEL = Path('/var/lib/desos-dev/channel')
FOLLOW_KEYRING = Path('/usr/share/keyrings/desos-dev-published.gpg')
FOLLOW_SOURCE = Path('/etc/apt/sources.list.d/desos-dev-published.sources')


def say(text):
    print(f'desos-dev: {text}', flush=True)


def run(command, **kwargs):
    return subprocess.run(command, check=True, **kwargs)


def sudo(*command):
    return run(['sudo', *command])


def dev_version(base, stamp, commit):
    """A version above `base` and above every earlier build: base+devYYYYMMDDHHMM.gSHA.
    An official release of the next version still sorts above it."""
    return f'{base}+dev{stamp:%Y%m%d%H%M}.g{commit[:9]}'


def cargo_version(source):
    text = (source / 'shell/Cargo.toml').read_text()
    match = re.search(r'^version\s*=\s*"([^"]+)"', text, re.M)
    if not match:
        raise SystemExit(f'desos-dev: no version in {source}/shell/Cargo.toml')
    return match.group(1)


def ensure_toolchain():
    if shutil.which('cargo') and run(['cargo', '--version'], capture_output=True).returncode == 0:
        return
    say('installing the stable Rust toolchain (rustup, once)')
    run(['rustup', 'default', 'stable'])


def setup(source):
    if not (source / '.git').is_dir():
        say(f'getting DEs-UI into {source}')
        run(['git', 'clone', REPOSITORY, str(source)])
    ensure_toolchain()
    say('making the local channel (asks for your password)')
    sudo('desos-dev-channel', 'init')
    say('ready: run "desos-dev update" after you change DEs-UI')


def installed():
    out = subprocess.run(['dpkg-query', '-W', '-f', '${Package} ${Version} ${db:Status-Abbrev}\\n', *PACKAGES],
                         capture_output=True, text=True).stdout
    return {fields[0]: fields[1] for fields in (line.split() for line in out.splitlines())
            if len(fields) >= 3 and fields[2].startswith('ii')}


def update(source, pull):
    if not (source / '.git').is_dir():
        raise SystemExit(f'desos-dev: no DEs-UI checkout at {source}; run "desos-dev setup" first')
    if pull:
        say('pulling the latest DEs-UI')
        run(['git', '-C', str(source), 'pull', '--ff-only'])
    ensure_toolchain()
    commit = run(['git', '-C', str(source), 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
    dirty = run(['git', '-C', str(source), 'status', '--porcelain'], capture_output=True, text=True).stdout.strip()
    version = dev_version(cargo_version(source), datetime.datetime.now(datetime.timezone.utc), commit)
    if dirty:
        say('note: building uncommitted changes too')
    say(f'building DEs-UI {version} (the first build takes a while)')
    env = dict(os.environ, DESUI_DEB_VERSION=version)
    try:
        run(['sh', 'packaging/build-deb.sh'], cwd=source, env=env)
    except subprocess.CalledProcessError as error:
        # The real error sits above hundreds of compiler warnings; say plainly
        # that the build stopped and that nothing changed.
        raise SystemExit(f'desos-dev: the DEs-UI build failed (exit {error.returncode}); nothing was '
                         'installed. The error is the last lines before this one that are not warnings.') from None
    debs = sorted(str(p) for p in (source / 'target/deb').glob(f'*_{version}_*.deb'))
    if not debs:
        raise SystemExit('desos-dev: the build made no packages')
    say('signing into the local channel and upgrading (asks for your password)')
    sudo('desos-dev-channel', 'add', *debs)
    # Read only the local channel, so an update works offline and fast.
    sudo('apt-get', 'update', '-o', 'Dir::Etc::sourcelist=/etc/apt/sources.list.d/desos-dev.sources',
         '-o', 'Dir::Etc::sourceparts=-', '-o', 'APT::Get::List-Cleanup=0')
    present = sorted(installed())
    if present:
        sudo('apt-get', 'install', '-y', '--only-upgrade', *present)
    else:
        sudo('apt-get', 'install', '-y', 'des-ui')
    now = installed()
    say('installed: ' + ', '.join(f'{name} {v}' for name, v in sorted(now.items())))
    say('log out and back in to start the new desktop')


def status():
    channel = subprocess.run(['desos-dev-channel', 'status'], capture_output=True, text=True).stdout
    try:
        channel = json.loads(channel)
    except json.JSONDecodeError:
        channel = None
    print(json.dumps({'installed': installed(), 'channel': channel, 'source': str(SOURCE)}, indent=2))


def publish(repo, tag):
    """Upload the signed channel as the files of one GitHub release (needs `gh auth login`)."""
    import tempfile
    with tempfile.TemporaryDirectory(prefix='desos-dev-publish-') as staging:
        os.chmod(staging, 0o755)
        sudo('desos-dev-channel', 'export', staging)
        assets = sorted(Path(staging).iterdir())
        if run(['gh', 'release', 'view', tag, '--repo', repo], capture_output=True, check=False).returncode != 0:
            say(f'creating the "{tag}" release in {repo}')
            run(['gh', 'release', 'create', tag, '--repo', repo, '--title', 'DEs-UI updates', '--prerelease',
                 '--notes', 'The DEs-UI developer channel: an apt repository. On DesOS: '
                            f'desos-dev follow https://github.com/{repo}/releases/download/{tag}'])
        say(f'uploading {len(assets)} files')
        run(['gh', 'release', 'upload', tag, '--repo', repo, '--clobber', *map(str, assets)])
        listed = run(['gh', 'release', 'view', tag, '--repo', repo, '--json', 'assets', '--jq', '.assets[].name'],
                     capture_output=True, text=True).stdout.split()
        keep = {path.name for path in assets}
        for name in sorted(set(listed) - keep):
            run(['gh', 'release', 'delete-asset', tag, name, '--repo', repo, '--yes'])
    say(f'published: https://github.com/{repo}/releases/download/{tag}')


def follow(url):
    url = url.rstrip('/')
    if not url.startswith('https://'):
        raise SystemExit('desos-dev: the published channel must be an https:// address')
    key = urllib.request.urlopen(f'{url}/desos-dev.gpg', timeout=30).read()
    shown = subprocess.run(['gpg', '--show-keys', '--with-fingerprint'], input=key, capture_output=True).stdout.decode()
    print(shown)
    if input('Trust this key for DEs-UI updates? Type yes: ').strip() != 'yes':
        raise SystemExit('desos-dev: not changed')
    source = (f'# DEs-UI from {url}, signed by the developer key shown when it was added.\n'
              f'Types: deb\nURIs: {url}/\nSuites: ./\nSigned-By: {FOLLOW_KEYRING}\n')
    run(['sudo', 'tee', str(FOLLOW_KEYRING)], input=key, stdout=subprocess.DEVNULL)
    run(['sudo', 'tee', str(FOLLOW_SOURCE)], input=source.encode(), stdout=subprocess.DEVNULL)
    say('done: "sudo apt update && sudo apt upgrade" now includes DEs-UI from there')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('setup', 'update'):
        command = sub.add_parser(name)
        command.add_argument('--source', type=Path, default=SOURCE)
        if name == 'update':
            command.add_argument('--no-pull', action='store_true', help='build what is checked out, as it is')
    sub.add_parser('status')
    publishing = sub.add_parser('publish')
    publishing.add_argument('--repo', default=RELEASES)
    publishing.add_argument('--tag', default=TAG)
    following = sub.add_parser('follow')
    following.add_argument('url', nargs='?', default=f'https://github.com/{RELEASES}/releases/download/{TAG}')
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        raise SystemExit('desos-dev: run as yourself, not root; it asks for your password when needed')
    try:
        if args.command == 'setup':
            setup(args.source)
        elif args.command == 'update':
            update(args.source, not args.no_pull)
        elif args.command == 'status':
            status()
        elif args.command == 'publish':
            publish(args.repo, args.tag)
        else:
            follow(args.url)
    except subprocess.CalledProcessError as error:
        raise SystemExit(f'desos-dev: {" ".join(map(str, error.cmd))} failed ({error.returncode})') from None


if __name__ == '__main__':
    sys.exit(main())
