[Unit]
Description=DesOS undo: count this start and finish automatic recovery
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionKernelCommandLine=!boot=casper
ConditionPathIsMountPoint=/.snapshots

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/desos-undo boot-start

[Install]
WantedBy=sysinit.target
